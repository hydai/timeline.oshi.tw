# Snapshot data source for the timeline river.
# Production either sets this explicitly to a deployed snapshot URL, or omits it to
# fall back to the code default (https://data.oshi.tw/streams/v1/snapshot.json).
# Whatever host serves the snapshot must send `Access-Control-Allow-Origin`, since the
# browser fetches it cross-origin from timeline.oshi.tw.
NEXT_PUBLIC_SNAPSHOT_URL=/streams-sample.json
