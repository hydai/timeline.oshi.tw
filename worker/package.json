{
  "name": "timeline-streams-cache",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Internal cache Worker: TW VTuber live/upcoming/recent streams → data.oshi.tw/streams/v1",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply timeline-streams --local",
    "db:migrate:remote": "wrangler d1 migrations apply timeline-streams --remote",
    "build:seed": "tsx scripts/build-seed.ts",
    "import:seed": "tsx scripts/import-seed.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^24.13.6",
    "@vitest/coverage-istanbul": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
