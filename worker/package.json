{
  "name": "timeline-streams-cache",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal cache Worker: TW VTuber live/upcoming/recent streams → data.oshi.tw/streams/v1",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply timeline-streams --local",
    "db:migrate:remote": "wrangler d1 migrations apply timeline-streams --remote",
    "build:seed": "tsx scripts/build-seed.ts",
    "import:seed": "tsx scripts/import-seed.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@types/node": "^25.9.1",
    "@vitest/coverage-istanbul": "^4.1.7",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
